# This file contains no credentials. Copy it to .env and set your own API key.
# CLI execution commands read process environment variables only.
# `python -m miniagent studio` also reads this local .env as literal assignments;
# it never executes shell code, and existing environment variables take precedence.
# No python-dotenv dependency is needed. To load your trusted .env in sh/bash/zsh:
#   set -a
#   . ./.env
#   set +a
#   python -m miniagent run "Your task"
# Shell sourcing executes the file as shell code; use only your own local file.
# .env stays ignored by Git. Do not commit your API key or shell environment.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Supported: deepseek-flash or deepseek-v4-pro. An official /v1 base URL also works.
DEEPSEEK_MODEL=deepseek-flash

# enabled or disabled. reasoning_effort is sent only when thinking=enabled.
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
# Maximum output tokens per response: integer 1..393216; context window is 1M.
# 300000 is a ceiling, not a minimum or a requested response length.
DEEPSEEK_MAX_TOKENS=300000
# Per-attempt timeout and whole-request deadline, in positive seconds.
DEEPSEEK_TIMEOUT=120
DEEPSEEK_DEADLINE=3600
# Additional retries after the first attempt: integer 0..10.
DEEPSEEK_MAX_RETRIES=2
# 0..2; non-thinking requests preserve this value, including explicit zero.
MA_TEMPERATURE=0

# Task policy, separate from the model's single-response output limit.
# These defaults can also be overridden per task in the local Studio GUI.
# 0 counts model turns without a cumulative turn/action cap.
MA_MAX_STEPS=0
# 0 tracks usage without a cumulative token ceiling. A positive integer sets a cap.
MA_MAX_TOTAL_TOKENS=0
# 0 runs until completion or cancellation. Set 1..86400 for a task-wide wall clock.
MA_MAX_SECONDS=0
# Context capacity used for request projection (not a request to spend 1M tokens).
MA_CONTEXT_WINDOW_TOKENS=1000000
# Bounded recovery after output truncation; 0 disables recovery, maximum 3.
MA_OUTPUT_RECOVERY_ATTEMPTS=2
