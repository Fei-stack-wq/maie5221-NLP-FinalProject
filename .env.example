# Copy to .env and set your API key. `python -m miniagent` reads ./.env as
# literal KEY=value pairs (nothing is executed); process environment wins.
# .env is ignored by Git — never commit your key.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# enabled or disabled; reasoning effort is sent only when thinking is enabled
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
# Per-response output ceiling (1..393216); not a target length
DEEPSEEK_MAX_TOKENS=300000
# Per-attempt timeout and whole-request deadline (seconds); extra retries 0..10
DEEPSEEK_TIMEOUT=180
DEEPSEEK_DEADLINE=900
DEEPSEEK_MAX_RETRIES=3
MA_TEMPERATURE=0

# Every loop is bounded. Steps must be 1..1000 (0 is not "unlimited").
# Member steps per assignment, lead steps per task, delegations per task.
MA_MAX_STEPS=100
MA_LEAD_MAX_STEPS=80
MA_MAX_DELEGATIONS=24
# Optional wall clock per agent run in seconds; 0 = bounded by steps only
MA_MAX_SECONDS=0
# Compaction starts when a request reaches this many tokens
MA_COMPACT_AT_TOKENS=110000
MA_KEEP_RECENT_TOKENS=32000
# interactive (agents may ask you) or autonomous (they decide and state assumptions)
MA_INTERACTION_MODE=interactive

# Event-linked plan progress, including fast tasks (requires MA_PLANS).
MA_PLAN_LINKS=1
# Experimental team communication. Set these to 1 to enable the complete profile.
# Interrupts and consults use mailboxes. Team check-ins also use lead consults.
MA_MAILBOXES=0
MA_INTERRUPTS=0
MA_LEAD_CONSULT=0
MA_TEAM_TALK=0
